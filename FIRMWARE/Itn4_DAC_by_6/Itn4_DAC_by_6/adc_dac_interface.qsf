set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"
set_location_assignment PIN_E4 -to SYS_RESET
set_location_assignment PIN_G1 -to CLKY2
set_location_assignment PIN_E1 -to AD_CONVST
set_location_assignment PIN_C1 -to AD_CS
set_location_assignment PIN_E3 -to AD_SCLK
set_location_assignment PIN_B2 -to AD_SDI
set_location_assignment PIN_B1 -to AD_SDO
set_location_assignment PIN_AA17 -to DA1_LD
set_location_assignment PIN_AB17 -to DA1_SRI
set_location_assignment PIN_AA16 -to DA2_LD
set_location_assignment PIN_AB16 -to DA2_SRI
set_location_assignment PIN_W13 -to DA3_LD
set_location_assignment PIN_W14 -to DA3_SRI
set_location_assignment PIN_AA15 -to DA4_LD
set_location_assignment PIN_AB15 -to DA4_SRI
set_location_assignment PIN_AA14 -to DA5_LD
set_location_assignment PIN_AB14 -to DA5_SRI
set_location_assignment PIN_AA13 -to DA6_LD
set_location_assignment PIN_AB13 -to DA6_SRI
