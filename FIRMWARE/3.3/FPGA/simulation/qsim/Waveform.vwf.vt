// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "01/24/2019 09:07:53"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    MultipleADC
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module MultipleADC_vlg_sample_tst(
	e_mdio,
	e_rxc,
	e_rxd,
	e_rxdv,
	e_rxer,
	e_txc,
	fpga_gclk,
	reset_n,
	sampler_tx
);
input  e_mdio;
input  e_rxc;
input [7:0] e_rxd;
input  e_rxdv;
input  e_rxer;
input  e_txc;
input  fpga_gclk;
input  reset_n;
output sampler_tx;

reg sample;
time current_time;
always @(e_mdio or e_rxc or e_rxd or e_rxdv or e_rxer or e_txc or fpga_gclk or reset_n)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module MultipleADC_vlg_check_tst (
	e_gtxc,
	e_mdc,
	e_mdio,
	e_reset,
	e_txd,
	e_txen,
	e_txer,
	sendtrigger,
	sampler_rx
);
input  e_gtxc;
input  e_mdc;
input  e_mdio;
input  e_reset;
input [7:0] e_txd;
input  e_txen;
input  e_txer;
input  sendtrigger;
input sampler_rx;

reg  e_gtxc_expected;
reg  e_mdc_expected;
reg  e_mdio_expected;
reg  e_reset_expected;
reg [7:0] e_txd_expected;
reg  e_txen_expected;
reg  e_txer_expected;
reg  sendtrigger_expected;

reg  e_gtxc_prev;
reg  e_mdc_prev;
reg  e_mdio_prev;
reg  e_reset_prev;
reg [7:0] e_txd_prev;
reg  e_txen_prev;
reg  e_txer_prev;
reg  sendtrigger_prev;

reg  sendtrigger_expected_prev;

reg  last_sendtrigger_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:8] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 8'b1;
end

// update real /o prevs

always @(trigger)
begin
	e_gtxc_prev = e_gtxc;
	e_mdc_prev = e_mdc;
	e_mdio_prev = e_mdio;
	e_reset_prev = e_reset;
	e_txd_prev = e_txd;
	e_txen_prev = e_txen;
	e_txer_prev = e_txer;
	sendtrigger_prev = sendtrigger;
end

// update expected /o prevs

always @(trigger)
begin
	sendtrigger_expected_prev = sendtrigger_expected;
end



// expected sendtrigger
initial
begin
	sendtrigger_expected = 1'bX;
	sendtrigger_expected = #999000 1'b0;
end 
// generate trigger
always @(e_gtxc_expected or e_gtxc or e_mdc_expected or e_mdc or e_mdio_expected or e_mdio or e_reset_expected or e_reset or e_txd_expected or e_txd or e_txen_expected or e_txen or e_txer_expected or e_txer or sendtrigger_expected or sendtrigger)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected e_gtxc = %b | expected e_mdc = %b | expected e_mdio = %b | expected e_reset = %b | expected e_txd = %b | expected e_txen = %b | expected e_txer = %b | expected sendtrigger = %b | ",e_gtxc_expected_prev,e_mdc_expected_prev,e_mdio_expected_prev,e_reset_expected_prev,e_txd_expected_prev,e_txen_expected_prev,e_txer_expected_prev,sendtrigger_expected_prev);
	$display("| real e_gtxc = %b | real e_mdc = %b | real e_mdio = %b | real e_reset = %b | real e_txd = %b | real e_txen = %b | real e_txer = %b | real sendtrigger = %b | ",e_gtxc_prev,e_mdc_prev,e_mdio_prev,e_reset_prev,e_txd_prev,e_txen_prev,e_txer_prev,sendtrigger_prev);
`endif
	if (
		( sendtrigger_expected_prev !== 1'bx ) && ( sendtrigger_prev !== sendtrigger_expected_prev )
		&& ((sendtrigger_expected_prev !== last_sendtrigger_exp) ||
			on_first_change[8])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port sendtrigger :: @time = %t",  $realtime);
		$display ("     Expected value = %b", sendtrigger_expected_prev);
		$display ("     Real value = %b", sendtrigger_prev);
		nummismatches = nummismatches + 1;
		on_first_change[8] = 1'b0;
		last_sendtrigger_exp = sendtrigger_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#5000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module MultipleADC_vlg_vec_tst();
// constants                                           
// general purpose registers
reg treg_e_mdio;
reg e_rxc;
reg [7:0] e_rxd;
reg e_rxdv;
reg e_rxer;
reg e_txc;
reg fpga_gclk;
reg reset_n;
// wires                                               
wire e_gtxc;
wire e_mdc;
wire e_mdio;
wire e_reset;
wire [7:0] e_txd;
wire e_txen;
wire e_txer;
wire sendtrigger;

wire sampler;                             

// assign statements (if any)                          
assign e_mdio = treg_e_mdio;
MultipleADC i1 (
// port map - connection between master ports and signals/registers   
	.e_gtxc(e_gtxc),
	.e_mdc(e_mdc),
	.e_mdio(e_mdio),
	.e_reset(e_reset),
	.e_rxc(e_rxc),
	.e_rxd(e_rxd),
	.e_rxdv(e_rxdv),
	.e_rxer(e_rxer),
	.e_txc(e_txc),
	.e_txd(e_txd),
	.e_txen(e_txen),
	.e_txer(e_txer),
	.fpga_gclk(fpga_gclk),
	.reset_n(reset_n),
	.sendtrigger(sendtrigger)
);

// fpga_gclk
always
begin
	fpga_gclk = 1'b0;
	fpga_gclk = #500 1'b1;
	#500;
end 

// reset_n
initial
begin
	reset_n = 1'b1;
end 

MultipleADC_vlg_sample_tst tb_sample (
	.e_mdio(e_mdio),
	.e_rxc(e_rxc),
	.e_rxd(e_rxd),
	.e_rxdv(e_rxdv),
	.e_rxer(e_rxer),
	.e_txc(e_txc),
	.fpga_gclk(fpga_gclk),
	.reset_n(reset_n),
	.sampler_tx(sampler)
);

MultipleADC_vlg_check_tst tb_out(
	.e_gtxc(e_gtxc),
	.e_mdc(e_mdc),
	.e_mdio(e_mdio),
	.e_reset(e_reset),
	.e_txd(e_txd),
	.e_txen(e_txen),
	.e_txer(e_txer),
	.sendtrigger(sendtrigger),
	.sampler_rx(sampler)
);
endmodule

